{
  "manifest_version": 3,
  "name": "Allthatbook — Import a booking",
  "version": "0.2.0",
  "minimum_chrome_version": "102",
  "description": "Collect booking details across pages and review them in Allthatbook.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add to Allthatbook"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://allthatbook.vercel.app/*"
    ]
  },
  "host_permissions": [
    "https://allthatbook.vercel.app/*"
  ]
}
